{
  "name": "desafio-agibank-dog-api",
  "version": "1.0.0",
  "description": "Automação de testes de API - Dog CEO",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "clean:reports": "rimraf cypress/reports",
    "pretest": "pnpm clean:reports",
    "test": "cypress run --reporter mochawesome --reporter-options overwrite=false,html=false,json=true,reportDir=cypress/reports || pnpm report:all",
    "report:merge": "mochawesome-merge cypress/reports/*.json -o cypress/reports/full_report.json",
    "report:generate": "marge cypress/reports/full_report.json -f report -o cypress/reports/html",
    "report:all": "pnpm report:merge && pnpm report:generate"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.2",
    "typescript": "^5.0.0"
  },
  "author": "Naelton Marques",
  "license": "ISC",
  "dependencies": {
    "cypress": "^15.8.2",
    "cypress-axe": "^1.7.0"
  }
}